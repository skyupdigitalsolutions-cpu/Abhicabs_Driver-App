{
  "expo": {
    "name": "ABHI CABS Driver",
    "slug": "abhicabs-driver-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abhicabs.driver",
      "splash": {},
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC007"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "package": "com.abhicabs.driver",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAd_GRgHCsqGr1bD3u8J2BUBhI-DsgWz-0"
        }
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ABHI CABS Driver to use your location to show your position on the map and navigate to pickups.",
          "isIosBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Allow ABHI CABS Driver to use your location to show your position on the map and navigate to pickups."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ABHI CABS Driver to access your camera to upload documents.",
          "microphonePermission": false,
          "photosPermission": "Allow ABHI CABS Driver to access your photo library to upload documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC107"
        }
      ],
      "expo-secure-store",
      "./plugins/withSceneLifecycle",
      "./plugins/withStripAndroidPermissions"
    ]
  }
}