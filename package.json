{
  "name": "abhicabs-driver-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:aab": "eas build --platform android --profile production --non-interactive",
    "build:ios-sim": "eas build --platform ios --profile preview --non-interactive",
    "build:ios-device": "eas build --platform ios --profile preview:device --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:all": "eas build --platform all --profile production --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@reduxjs/toolkit": "^2.3.0",
    "expo": "~51.0.0",
    "expo-device": "~6.0.0",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.0.7",
    "expo-location": "~17.0.0",
    "expo-notifications": "~0.28.0",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.0",
    "lucide-react-native": "^0.378.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.0",
    "react-native-svg": "15.2.0",
    "react-redux": "^9.1.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.73.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.0"
  },
  "private": true
}
